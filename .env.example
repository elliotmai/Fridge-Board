# Server-side only (Netlify function environment), never VITE_-prefixed, so no
# app token ever ships to the tablet. Not used yet: the board shows sample data
# until each feed is connected.
#
# GALAXYFARM_TOKEN=
# KITCHENHUB_TOKEN=
# LEARNLEAF_TOKEN=
# WANDER_TOKEN=
# ZNT_PROJECT_ID=znt-manager

# Hive sign-in (step 2). The four VITE_ values are Hive's Firebase web config
# (Firebase console → Project settings → Your apps). They end up in the page,
# which is fine. HIVE_SIGNING_KEY is secret and server-only: make it with
# `node scripts/hive-keys.mjs`, and give the matching HIVE_PUBLIC_KEY to apps.
#
# VITE_HIVE_FIREBASE_API_KEY=
# VITE_HIVE_FIREBASE_AUTH_DOMAIN=
# VITE_HIVE_FIREBASE_PROJECT_ID=
# VITE_HIVE_FIREBASE_APP_ID=
# HIVE_SIGNING_KEY=
