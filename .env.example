# Server-side only (Netlify function environment), never VITE_-prefixed, so no
# app token ever ships to the tablet. Not used yet: the board shows sample data
# until each feed is connected.
#
# GALAXYFARM_TOKEN=
# KITCHENHUB_TOKEN=
# LEARNLEAF_TOKEN=
# WANDER_TOKEN=
# ZNT_PROJECT_ID=znt-manager

# Hive sign-in. Hive's Firebase config and public key are in src/config/hive.js
# (public by design). The one secret, server-only: the private half of that
# key. `node scripts/hive-keys.mjs` makes a new pair if it's ever needed.
#
# HIVE_SIGNING_KEY=
